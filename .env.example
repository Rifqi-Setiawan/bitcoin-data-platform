# Bitcoin Data Platform Configuration Example
# Copy to .env and adjust as needed. Do NOT commit secrets or real credentials to git.

# Data and state directories
BDP_DATA_DIR=./data
BDP_RAW_DIR=./data/raw
BDP_CURATED_DIR=./data/curated
BDP_STATE_DIR=./data/state

# Coinbase API settings
BDP_COINBASE_API_BASE=https://api.exchange.coinbase.com
BDP_REQUEST_TIMEOUT_SECONDS=10
BDP_MAX_RETRIES=5

# Logging settings
BDP_LOG_LEVEL=INFO
