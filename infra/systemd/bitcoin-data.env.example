# ==============================================================================
# Bitcoin Data Platform - Systemd Environment Configuration Template
# Target location on host: /etc/bitcoin-data/bitcoin-data.env
# File permissions: 0640 (root:bitcoin-data)
# ==============================================================================

# Ensure Python output streams are unbuffered so journald captures logs immediately
PYTHONUNBUFFERED=1

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
BITCOIN_DATA_LOG_LEVEL=INFO

# Coinbase Exchange REST Client Settings
# COINBASE_TIMEOUT_SECONDS=10.0
# COINBASE_MAX_RETRIES=3

# Optional: Override current UTC clock for dry-run, testing, or historical replay
# Must be ISO-8601 format with explicit UTC designator (e.g. 2026-01-02T15:00:00Z)
# BITCOIN_DATA_OVERRIDE_NOW_UTC=2026-01-02T15:00:00Z
